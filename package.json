{
  "name": "iglesia-web-backend",
  "version": "1.0.0",
  "description": "API de la Iglesia Evangélica de Dios Pentecostal, Talca. Autenticación con roles y gestión de documentos sobre Supabase Storage.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node pruebas/api.test.js && node pruebas/e2e.test.js",
    "test:deps": "npm install --no-save mongodb-memory-server jsdom",
    "mantener-activo": "node scripts/mantener-activo.js"
