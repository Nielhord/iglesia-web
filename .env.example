# ============================================
# Servidor
# ============================================
PORT=3000
NODE_ENV=development

# URL pública del backend. Se usa para construir los enlaces de descarga.
BASE_URL=http://localhost:3000

# Orígenes autorizados por CORS, separados por coma.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# ============================================
# Seguridad (JWT)
# ============================================
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# ============================================
# Base de Datos (MongoDB Atlas)
# ============================================
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/iglesia?retryWrites=true&w=majority

# ============================================
# Almacenamiento (Supabase)
# ============================================
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta de servicio. Solo en el servidor, NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=archivos

# ============================================
# Subida de archivos
# ============================================
MAX_FILE_SIZE_MB=10
